Resource SecondaryText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="8,0"/><TextBlock Grid.Column="2" Text="{Binding Scope}" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/><TextBlock Grid.Column="3" Text="{Binding Invocation}" Foreground="{DynamicResource Muted}" FontSize="10" VerticalAlignment="Center"/><Border x:Name="SkillStateBadge" Grid.Column="4" Background="{DynamicResource SuccessBadgeBg}" CornerRadius="7" Padding="7,3" HorizontalAlignment="Left" VerticalAlignment="Center"><TextBlock x:Name="SkillStateText" Text="{Binding StateText}" Foreground="{DynamicResource SuccessText}" FontSize="10"/></Border></Grid><DataTemplate.Triggers><DataTrigger Binding="{Binding Enabled}" Value="False"><Setter TargetName="SkillStateBadge" Property="Background" Value="{DynamicResource WarningBadgeBg}"/><Setter TargetName="SkillStateText" Property="Foreground" Value="{DynamicResource WarningText}"/></DataTrigger><DataTrigger Binding="{Binding IsValid}" Value="False"><Setter TargetName="SkillStateBadge" Property="Background" Value="{DynamicResource DangerPanelBg}"/><Setter TargetName="SkillStateText" Property="Foreground" Value="{DynamicResource DangerText}"/></DataTrigger></DataTemplate.Triggers></DataTemplate></ListView.ItemTemplate></ListView><StackPanel x:Name="SkillEmptyState" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="尚未发现 Skill" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="可以从上方导入或创建一个模板" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center"/></StackPanel></Grid></Border>

