                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="鲸鱼娘昼夜工坊" FontWeight="SemiBold"/><TextBlock Text="完整昼夜角色主题 · CC BY-NC-SA 4.0 · 禁止商用" Foreground="{DynamicResource Muted}" FontSize="10" Margin="0,3,12,0" TextWrapping="Wrap"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><RadioButton x:Name="SetupDeepWhaleKeepChoice" GroupName="SetupDeepWhale" Style="{StaticResource CompactChoice}" Content="保留关闭" IsChecked="True"/><RadioButton x:Name="SetupDeepWhaleEnableChoice" GroupName="SetupDeepWhale" Style="{StaticResource CompactChoice}" Content="启用"/><RadioButton x:Name="SetupDeepWhaleRemoveChoice" GroupName="SetupDeepWhale" Style="{StaticResource CompactDangerChoice}" Content="删除"/></StackPanel></Grid>
