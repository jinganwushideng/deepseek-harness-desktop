                <Border Style="{StaticResource Card}" Padding="16"><StackPanel><TextBlock Text="导入现有 Skill" FontWeight="SemiBold"/><TextBlock Text="选择包含 SKILL.md 的目录，或单个 Markdown Skill" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,3,0,10" TextWrapping="Wrap"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="SkillImportPathBox" IsReadOnly="True" ToolTip="尚未选择 Skill"/><Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="选择目录" Margin="8,0,0,0" Click="BrowseSkillDirectoryButton_Click"/></Grid><WrapPanel Margin="0,9,0,0"><Button Style="{StaticResource SecondaryButton}" Content="选择 Markdown" Margin="0,0,8,7" Click="BrowseSkillMarkdownButton_Click"/><Button Style="{StaticResource PrimaryButton}" Content="导入到用户" Margin="0,0,8,7" Click="ImportUserSkillButton_Click"/><Button Style="{StaticResource SecondaryButton}" Content="导入到项目" Margin="0,0,0,7" Click="ImportProjectSkillButton_Click"/></WrapPanel></StackPanel></Border>
