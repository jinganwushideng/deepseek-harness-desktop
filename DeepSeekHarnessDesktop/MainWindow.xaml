      </Grid>

      <Grid x:Name="InstallProgressOverlay" Panel.ZIndex="250" Background="#B8000000" Visibility="Collapsed">
        <Border Width="570" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="18" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center">
          <StackPanel>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="InstallProgressTitle" Text="正在安装插件" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="请保持程序运行，完成后会自动恢复 Harness 服务。" Foreground="{DynamicResource Muted}" FontSize="10" Margin="0,4,14,0"/></StackPanel><Border Grid.Column="1" Width="38" Height="38" CornerRadius="12" Background="{DynamicResource InfoIconBg}" ClipToBounds="True"><Image Source="Assets/WhaleGirl-v2.png" Stretch="UniformToFill"/></Border></Grid>
            <ProgressBar x:Name="InstallProgressBar" Minimum="0" Maximum="100" Value="0" Height="7" Margin="0,24,0,14" Foreground="{DynamicResource Accent}" Background="{DynamicResource LoadingTrack}" BorderThickness="0"/>
            <TextBlock x:Name="InstallProgressStage" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock x:Name="InstallProgressDetail" Foreground="{DynamicResource Muted}" FontSize="10" TextWrapping="Wrap" MinHeight="30" Margin="0,6,0,0"/>
            <Grid Margin="0,17,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="InstallProgressPercent" Text="0%" Foreground="{DynamicResource Accent}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/><Button x:Name="CancelInstallButton" Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="取消" HorizontalAlignment="Right" Padding="14,6" Click="CancelInstallButton_Click"/></Grid>
          </StackPanel>
        </Border>
      </Grid>

      <!-- WebView2 uses its own composition surface and can overpaint a normal
           WPF rounded clip. These masks keep the lower half of the seam truly
           rounded instead of allowing the browser's large square corners back. -->
      <Grid x:Name="ContentCornerMasks" Panel.ZIndex="100" IsHitTestVisible="False">
        <Grid Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Top">
          <Path Data="M0,0 L12,0 A12,12 0 0 0 0,12 Z" Fill="{DynamicResource ChromeBg}"/>
          <Path Data="M12,0 A12,12 0 0 0 0,12" Stroke="{DynamicResource Border}" StrokeThickness="1" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        </Grid>
        <Grid Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Top" RenderTransformOrigin="0.5,0.5">
          <Grid.RenderTransform><ScaleTransform ScaleX="-1"/></Grid.RenderTransform>
          <Path Data="M0,0 L12,0 A12,12 0 0 0 0,12 Z" Fill="{DynamicResource ChromeBg}"/>
          <Path Data="M12,0 A12,12 0 0 0 0,12" Stroke="{DynamicResource Border}" StrokeThickness="1" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        </Grid>
      </Grid>
    </Grid>
    </Border>
  </Grid>
  </Border>
</Window>
