<Window x:Class="DeepSeekHarnessDesktop.CatalogDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="项目主页" Width="1180" Height="780" MinWidth="760" MinHeight="520"
        WindowStyle="None" ResizeMode="CanResize" Background="Transparent" ShowInTaskbar="False">
  <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="48" ResizeBorderThickness="7" GlassFrameThickness="0" CornerRadius="14"/></shell:WindowChrome.WindowChrome>
  <Border x:Name="Frame" Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="14" ClipToBounds="True">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border Background="{DynamicResource TitleBarBackground}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" shell:WindowChrome.IsHitTestVisibleInChrome="True">
        <Grid Margin="14,0,6,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Border Width="28" Height="28" CornerRadius="8" Background="{DynamicResource LogoBackdrop}" ClipToBounds="True" VerticalAlignment="Center"><Image Source="Assets/WhaleGirl-v2.png" Stretch="UniformToFill"/></Border>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,12,0">
            <TextBlock x:Name="ProjectTitle" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <TextBlock x:Name="AddressText" Foreground="{DynamicResource Muted}" FontSize="10" Margin="14,1,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Button Style="{StaticResource SecondaryButton}" Content="浏览器打开" Padding="10,5" MinHeight="30" Margin="0,7,7,7" Click="OpenExternalButton_Click"/>
            <Button Style="{StaticResource IconButton}" ToolTip="刷新" Click="RefreshButton_Click"><Path Data="M20,7 A8,8 0 1 0 20,15 M20,3 L20,8 L15,8" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="17" Height="17" Stretch="Uniform"/></Button>
            <Button Style="{StaticResource IconButton}" ToolTip="关闭" Click="CloseButton_Click"><Path Data="M5,5 L17,17 M17,5 L5,17" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" Width="13" Height="13" Stretch="Uniform"/></Button>
          </StackPanel>
        </Grid>
      </Border>
      <Grid Grid.Row="1">
        <wv2:WebView2 x:Name="DetailBrowser" Visibility="Collapsed"/>
        <StackPanel x:Name="LoadingPanel" HorizontalAlignment="Center" VerticalAlignment="Center">
          <ProgressBar IsIndeterminate="True" Width="240" Height="3" Foreground="{DynamicResource Accent}" Background="{DynamicResource LoadingTrack}" BorderThickness="0"/>
          <TextBlock x:Name="LoadingText" Text="正在打开项目主页…" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" Margin="0,15,0,0"/>
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</Window>
