<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DeepSeekHarnessDesktop</AssemblyName>
    <RootNamespace>DeepSeekHarnessDesktop</RootNamespace>
    <Version>$(DesktopVersion)</Version>
    <Product>DeepSeek Harness Desktop</Product>
    <Authors>jinganwushideng</Authors>
    <Company>jinganwushideng</Company>
    <Copyright>Copyright © 2026 jinganwushideng</Copyright>
    <AssemblyTitle>DeepSeek Harness Desktop</AssemblyTitle>
    <Description>DeepSeek Harness 的本地 Windows 桌面壳与管理中心</Description>
    <FileVersion>$(DesktopVersion).0</FileVersion>
    <ApplicationIcon>Assets\Harness.ico</ApplicationIcon>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4129.50" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\WhaleGirl-v2.png" />
    <Resource Include="Assets\PluginPreviewPlaceholder.png" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets\runtime.seed.zip"
                      LogicalName="DeepSeekHarnessDesktop.runtime.seed.zip"
                      Condition="Exists('$(MSBuildProjectDirectory)\Assets\runtime.seed.zip')" />
    <EmbeddedResource Include="Assets\helper.mjs" LogicalName="DeepSeekHarnessDesktop.helper.mjs" />
    <EmbeddedResource Include="..\catalog\plugin-index.json" LogicalName="DeepSeekHarnessDesktop.plugin-index.json" />
    <EmbeddedResource Include="Assets\FeaturedSkins\deep-whale-day-night-theme-v0.1.1.install.zip"
                      LogicalName="DeepSeekHarnessDesktop.featured.deep-whale.zip"
                      Condition="Exists('$(MSBuildProjectDirectory)\Assets\FeaturedSkins\deep-whale-day-night-theme-v0.1.1.install.zip')" />
    <EmbeddedResource Include="Assets\FeaturedSkins\dshthemes-ui-0.2.0.tgz"
                      LogicalName="DeepSeekHarnessDesktop.featured.dshthemes-ui.tgz"
                      Condition="Exists('$(MSBuildProjectDirectory)\Assets\FeaturedSkins\dshthemes-ui-0.2.0.tgz')" />
    <EmbeddedResource Include="Assets\FeaturedSkins\dshthemes-core-0.2.0.tgz"
                      LogicalName="DeepSeekHarnessDesktop.featured.dshthemes-core.tgz"
                      Condition="Exists('$(MSBuildProjectDirectory)\Assets\FeaturedSkins\dshthemes-core-0.2.0.tgz')" />
    <EmbeddedResource Include="Assets\FeaturedSkins\clsx-2.1.1.tgz"
                      LogicalName="DeepSeekHarnessDesktop.featured.clsx.tgz"
                      Condition="Exists('$(MSBuildProjectDirectory)\Assets\FeaturedSkins\clsx-2.1.1.tgz')" />
  </ItemGroup>
</Project>
